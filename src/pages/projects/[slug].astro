---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ProjectBody from '../../components/islands/ProjectBody.astro';
import { getProject, listProjects } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const items = await listProjects();
	return items.map((node) => ({ params: { slug: node._sys.filename } }));
}
const slug = (Astro.params.slug ?? '').toString();
const res = await getProject(slug);
const data = res.data?.project;
if (!data) return new Response('Not Found', { status: 404 });
---
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{data.title} · Ahmed ElMenyawy</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Stencil+One&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap">
<style is:global>
	body{margin:0;background:#16130f;font:16px/1.6 "IBM Plex Sans",system-ui,sans-serif;color:#1e1a16}
	.sheet{max-width:880px;margin:0 auto;background:#f4efe6;min-height:100vh;padding:40px max(20px,4vw) 80px;box-sizing:border-box}
	.eyebrow{font:500 11px/1 "IBM Plex Mono",monospace;letter-spacing:.14em;text-transform:uppercase;color:#a5532a;margin:0 0 8px}
	h1{font:400 clamp(40px,6vw,64px)/1 "Saira Stencil One",Impact,sans-serif;margin:0 0 10px}
	h2{font:500 13px/1.3 "IBM Plex Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:#56653f;margin:32px 0 8px}
	.ar{font-family:"IBM Plex Sans Arabic",Tahoma,sans-serif;text-align:right}
	.ar-title{font-size:30px;font-weight:600;margin:0 0 12px}
	.facts{display:flex;flex-wrap:wrap;gap:8px 28px;margin:14px 0}
	.facts dt{font:500 11px "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:#6a6056}
	.facts dd{margin:0}
	.chips{display:flex;flex-wrap:wrap;gap:6px}
	.chips span{font:12px "IBM Plex Mono",monospace;border:1px solid #ddd3c4;background:#fff;border-radius:20px;padding:3px 10px}
	.lead{font-size:18px;max-width:68ch}
	figure{margin:18px 0} figure img,.gal img{width:100%;border-radius:4px;display:block}
	figcaption{font-size:13px;color:#6a6056;margin-top:6px}
	.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px}
	.trial{position:fixed;left:12px;bottom:12px;background:#e3ad4f;color:#1a1510;font:600 12px "IBM Plex Mono",monospace;padding:6px 10px;border-radius:3px}
</style>
</head>
<body>
	<TinaIsland name="project" wrapper={islands.project.wrapper} params={{ slug }} primary>
		<ProjectBody data={data} />
	</TinaIsland>
	<p class="trial">TinaCMS trial</p>
</body>
</html>
